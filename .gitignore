# ============================================================================
# The split this repo is built on: SOURCE is tracked, OUTPUT is not.
#
# Everything below is REGENERATED by a script in this repo. If you find
# yourself wanting to commit one of these, the real question is why the script
# that makes it is not enough.
#
# The single exception is documented in bedek/video/README.md: fal.ai clips are
# not deterministic, so re-running costs money and gives similar-but-different
# footage. They are still excluded -- 19MB of binaries in git is worse -- but
# they live in SharePoint and the cost is ~$1.20 to rebuild.
# ============================================================================

# built by npm
node_modules/
dist/
*.tsbuildinfo

# built by the pipeline scripts
*/video/clips/
*/video/out/
*/video/audio/
*/video/cards/
*/video/_tmp/
*/video/_voicetest/
*/social/out/
*/_pdf/
*/brand/palette/preview.html
*/brand/palette/tokens.css
*/brand/palette/directions.json
*/assets/logos/
*/content/onepager/onepager.pdf
*/brand/logo/logos.html
*/brand/logo/logo-kit.html
*/brand/logo/marks/
*/content/onepager/onepager.html
*/content/onepager/onepager.png
*/site/public/404.html
*/site/public/privacy.html
*/site/public/mark*.svg
*/site/public/favicon.svg
*/site/public/app-icon.svg
*/site/src/styles/tokens.css
*/site/src/styles/type.css

# media never belongs in git
*.mp4
*.mp3
*.wav

# infrastructure ids written by the deploy scripts
*/ops/.distribution-id
*/ops/.cert-arn
*/ops/.oac-id
*/ops/lead-proxy/.endpoint
*/ops/lead-proxy/function.zip

# secrets live ONLY in the shared .env -- see CLAUDE.md
.env
.env.local
*.pem

# python
__pycache__/
*.pyc

# os
Thumbs.db
.DS_Store

# NOT ignored, and deliberately so:
#   */brand/fonts/type.css   hand-written typography spec -- a SOURCE
#   */site/.env.production   holds only VITE_LEAD_ENDPOINT=/api/lead, no secret,
#                            and a clean build without it ships a dead form
#   */site/package-lock.json reproducible installs

# scratch
_qa/
_frames/
_shot-*.png
